{
  "name": "ultra-reporter-app",
  "version": "0.7.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome lint",
    "deploy": "turbo run build --scope=app --includeDependencies --no-deps",
    "format:fix": "biome format --write",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "prepare": "husky",
    "release": "release-it --ci",
    "release:major": "pnpm release major",
    "release:minor": "pnpm release minor",
    "release:patch": "pnpm release patch",
    "release:premajor": "pnpm beta premajor",
    "release:preminor": "pnpm beta preminor",
    "release:prepatch": "pnpm beta prepatch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@release-it-plugins/lerna-changelog": "^8.0.1",
    "@types/node": "^24.9.1",
    "@vercel/style-guide": "^6.0.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lerna-changelog": "^2.2.0",
    "lint-staged": "^16.2.6",
    "release-it": "^19.0.5",
    "release-it-pnpm": "^4.6.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,mjs,json,jsonc}": [
      "pnpm format:fix",
      "pnpm format",
      "pnpm lint:fix",
      "pnpm lint"
    ],
    "**/*.css": [
      "pnpm format:fix",
      "pnpm format"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0"
}
